{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sambanova Agents Service Audio File Management API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "File Management",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Download Agent File",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://chat.sambanova.ai/api/agent/files/:file_id",
            "params": [
              {
                "name": "file_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Download files (artifacts) generated by agent APIs using Bearer token authentication. Files are scoped to users, and the storage layer verifies ownership before returning data.\n"
        }
      ]
    }
  ],
  "bundled": true
}